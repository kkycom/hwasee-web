rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 주의: Firestore 규칙은 매칭되는 모든 match 블록을 OR로 평가함
    // (더 구체적인 규칙이 우선하는 게 아님). 그래서 하위 경로를 개별 차단하려면
    // 상위에 `{document=**}` 같은 전체 허용 와일드카드를 절대 두면 안 되고,
    // 아래처럼 컬렉션을 하나씩 명시해야 함.

    // config: ai_config/used_openings/stats 등은 클라이언트가 직접 읽고 씀.
    // secrets(Claude API 키 등 평문 비밀값)만 예외적으로 완전 차단 —
    // Cloud Functions(getClaudeKeyStatus/setClaudeKey, Admin SDK)만 접근 가능.
    match /config/secrets {
      allow read, write: if false;
    }
    match /config/{configId} {
      allow read, write: if configId != 'secrets';
    }

    // users/point_ledger: 2026-07-04 익명 인증(auth_uid 바인딩) 도입 이후 실제
    // 소유권 검증 적용. auth_uid가 아직 null인 문서는 "선점 없음"으로 간주해
    // 계속 쓰기 허용(레거시 계정 첫 액션이 곧 바인딩). 기기 변경 재바인딩은
    // register/login/loginWithGoogle/loginWithKakao Cloud Function(Admin SDK,
    // 비밀번호나 실제 소셜 OAuth 검증 후에만) 전용으로 완전히 이관됨(2026-07-13).
    //
    // ⚠️ 2026-07-17 보강(간편가입 도입 계기 발견): create는 register 등 계정 생성이
    // 전부 Cloud Function으로 이관되며 클라이언트가 더 이상 호출할 이유가 없어져서
    // 완전 차단. update도 auth_uid/google_uid/kakao_uid를 더 엄격히 제한 —
    // 예전엔 "본인 문서 소유자면 어느 필드든 원하는 값으로" 쓸 수 있어서, users가
    // 공개 read인 걸 이용해 남의 google_uid/kakao_uid를 읽어다 자기(또는 미끼)
    // 계정에 그대로 복사해두면, 나중에 그 사람이 실제로 구글/카카오 로그인할 때
    // 미끼 계정으로 잘못 연결될 수 있는 사전 계정 탈취(pre-hijacking류) 위험이
    // 있었음. auth_uid는 "자기 자신의 현재 실제 세션으로만" 갱신 허용(레거시
    // 백필 패턴과 일치), google_uid/kakao_uid는 클라이언트가 값 자체를 아예
    // 못 건드리게 함(전부 Cloud Function 전용 필드).
    //
    // 🚨 2026-08-03 긴급 보강(보안방 전수조사 중 발견, 실제로 curl 재현해 확인함):
    // banned_until/ban_reason(2026-08-02 도입, adminBanUser/adminUnbanUser 전용
    // 필드)이 이 보호 목록에 없어서, 정지된 유저가 자기 문서 소유권(auth_uid
    // 일치)을 그대로 갖고 있는 걸 이용해 직접 Firestore 쓰기로 banned_until을
    // 지워 스스로 정지를 해제할 수 있었음(로그인/verifySession의 _activeBan
    // 체크를 완전히 우회) — 실제 합성 계정으로 자가-정지 후 자가-해제까지
    // 재현 성공한 뒤 즉시 잠금.
    // 🚨🚨 2026-08-03 추가 긴급 보강(같은 전수조사 연장선 — 유저의 어뷰징 제보를
    // 계기로 total_points 자체를 재점검하다 발견, curl로 999999999 덮어쓰기 성공
    // 재현함): total_points/badge는 그동안 보호 목록에 전혀 없어서 문서 소유자가
    // 원하는 값으로 직접 덮어쓸 수 있었음 — point_ledger(감사 로그)만 잠겨있고
    // 정작 실제 잔액 필드는 안 잠겨있던 맹점. total_points는 한 번의 쓰기에서
    // 늘어나는 폭을 정상 자기지급 최대치(연속출석 마일스톤 100p)보다 넉넉하게,
    // 줄어드는 폭은 최고가 아바타 구매(15000p)보다 넉넉하게 잡아 델타를 제한 —
    // "정상 액션 하나만큼만 매번 조금씩 바뀔 수 있다"로 좁혀서 잭팟형 위조를 막음
    // (여러 번 걸쳐 조금씩 부정 적립하는 것까지는 이 규칙만으론 못 막지만, 그건
    // 이번에 발견된 "즉시 무한 포인트" 위험도와는 차원이 다름). badge는 유일하게
    // 실제 권한(버그 제보함 열람, fbGetBugReports)을 여는 'treeguard' 값으로
    // 새로 자가승격하는 것만 차단 — 그 외 포인트 등급 표시용 값은 계속 허용.
    match /users/{uid} {
      allow read: if true;
      allow create: if false;
      allow update: if request.auth != null &&
        (resource.data.auth_uid == null || resource.data.auth_uid == request.auth.uid) &&
        (request.resource.data.auth_uid == resource.data.auth_uid || request.resource.data.auth_uid == request.auth.uid) &&
        request.resource.data.get('google_uid', null) == resource.data.get('google_uid', null) &&
        request.resource.data.get('kakao_uid', null) == resource.data.get('kakao_uid', null) &&
        request.resource.data.get('banned_until', null) == resource.data.get('banned_until', null) &&
        request.resource.data.get('ban_reason', null) == resource.data.get('ban_reason', null) &&
        request.resource.data.get('total_points', 0) - resource.data.get('total_points', 0) <= 150 &&
        request.resource.data.get('total_points', 0) - resource.data.get('total_points', 0) >= -15000 &&
        (request.resource.data.get('badge', '') == resource.data.get('badge', '') ||
         request.resource.data.get('badge', '') != 'treeguard');
      allow delete: if request.auth != null &&
        (resource.data.auth_uid == null || resource.data.auth_uid == request.auth.uid);
    }
    match /point_ledger/{docId} {
      allow read: if true;
      allow create: if request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.resource.data.user_id)) ||
        get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.auth_uid == null ||
        get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.auth_uid == request.auth.uid
      );
      allow update, delete: if false; // 포인트 이력은 감사 추적용 — 수정/삭제 불가
    }

    // user_secrets(pw_hash/token): 2026-07-10 Auth 마이그레이션 5단계 — 완전 차단.
    // 예전엔 클라이언트가 로그인 시 직접 읽고 써야 해서 열어뒀었는데, 그 결과
    // 인증 없이 누구나 curl로 세션 토큰/비밀번호 해시를 읽을 수 있는 상태였음
    // (실제 노출 확인됨). pw_hash/token을 다루는 모든 경로(register/login/
    // verifySession/changePassword/resetPassword/deleteAccount)를 Cloud
    // Function(Admin SDK)으로 옮긴 뒤 여기를 잠금 — config/secrets와 동일 패턴.
    match /user_secrets/{docId} { allow read, write: if false; }

    // 그 외 컬렉션: 앱이 Firebase Auth를 쓰지 않고 자체 발급 user_id(localStorage)로
    // 신원을 관리하는 구조라 request.auth 기반 소유권 검증이 불가능함.
    // (실제 소유권/역할 검증을 하려면 Firebase Auth 도입이 선행되어야 함 — 별도 논의 필요)
    // stories는 다른 컬렉션처럼 완전 개방이지만, "오늘의 이야기" 스포트라이트
    // 슬롯(vote_threshold 필드로 식별)만은 예외 — 2026-07-14, 이 필드를 가진
    // 스토리가 원인불명으로 반복해서 status:'inactive'/'completed'로 바뀌는
    // 사고가 있었음(관리자 종료 버튼에서도 제외했지만, stories 전체가 인증
    // 없이 누구나 직접 쓸 수 있는 구조라 앱 밖에서의 쓰기도 막아야 확실함).
    // 우리 서버(Cloud Functions)는 Admin SDK를 쓰므로 이 규칙을 우회해서
    // 정상적인 스포트라이트 완결 처리는 그대로 동작함 — 여기서 막히는 건
    // 클라이언트/외부에서 오는 쓰기뿐.
    match /stories/{docId} {
      allow read: if true;
      allow create, delete: if true;
      // title/ai_title은 editStoryTitle/reportStoryTitle(Cloud Function,
      // Admin SDK라 이 규칙 자체를 안 탐) 전용 — stories 컬렉션이 이 문서
      // 전체가 인증 없이 열려있는 구조라, 이 가드가 없으면 클라이언트가
      // Firestore SDK로 직접 title을 덮어써서 신고 기능을 완전히 우회할
      // 수 있음(2026-08-26, "책의 언어" 책장 기능 설계 중 발견).
      allow update: if !(
        resource.data.get('vote_threshold', 0) > 0 &&
        resource.data.status == 'active' &&
        (request.resource.data.status == 'inactive' || request.resource.data.status == 'completed')
      ) && request.resource.data.get('title', null) == resource.data.get('title', null)
        && request.resource.data.get('ai_title', null) == resource.data.get('ai_title', null);
    }
    match /episodes/{docId} { allow read, write: if true; }
    // 🔒 2026-08-29 보안방(P0): submissions.vote_count가 완전 개방이라 closeEpisode의
    // 임계값 재검증(95cbbd7)을 로그인 계정 하나만으로 위조 통과시킬 수 있었음(실제
    // 공격 재현 확인) — 일반 투표를 voteEpisode(Cloud Function, 트랜잭션)로 이관하고
    // 여기서 vote_count/is_adopted 등 구조 필드를 클라이언트가 못 건드리게 잠금.
    // create는 초기값(0/false)만 강제해서 fbCreateSubmission은 그대로 통과.
    // update는 딱 두 갈래만 허용:
    //  (a) author_nickname만 — 닉네임 변경 캐스케이드, 투표/채택 상태와 무관(순수
    //      표시용 필드라 안전).
    //  (b) content/is_closing만, 단 그 문서가 아직 무투표·미채택일 때만 —
    //      fbEditMySubmission이 지금도 클라에서 확인하던 조건을 규칙으로도 강제.
    //      득표했거나 채택된 후보의 본문을 제3자가 바꿔치기해서 마감 결과를
    //      훼손하는 것도 막음(vote_count 보호만으론 이 경로가 남아있었음).
    // 관리자의 content 편집(투표/채택 상태 무관)·ai_reviewed 표시(글로벌화 번역
    // 안정화 조건으로 쓰일 예정이라 완전 서버 전용)는 위 화이트리스트에 안 넣고
    // adminEditSubmission/adminMarkAiReviewed(Admin SDK, 이 규칙 자체를 안 탐)로
    // 이관했음.
    // 🔒 2026-08-29 보안방(A-2): 위 P0 화이트리스트를 전면 차단으로 승격.
    // 남아있던 클라이언트 직접 쓰기 경로 5개를 전부 Cloud Function으로 이관 완료:
    //   fbCreateSubmission     → submitEpisode
    //   fbEditMySubmission     → editMySubmission
    //   fbDeleteMySubmission   → deleteMySubmission
    //   fbChangeDisplayName    → changeDisplayName (author_nickname 캐스케이드 포함)
    //   fbCreateBranch         → createStoryBranch (미채택 제출물 복사)
    //   fbAdminDeleteSubmission→ adminDeleteSubmission
    // 이제 submissions에 쓰는 주체는 서버(Admin SDK, 이 규칙을 우회)뿐이고,
    // 제출 횟수 제한·에피소드 open 여부·소유권·득표/채택 상태 확인이 전부 서버에서
    // 강제된다 — 예전처럼 앱을 거치지 않고 Firestore에 직접 써서 그 검증을
    // 통째로 우회하는 경로가 사라짐(2026-08-04 be93ea7에 한계로 기록됐던 문제).
    // read는 반드시 열어둘 것: bang/index.html이 제출 목록을 onSnapshot 실시간
    // 구독으로 그리고 있어서, 여기를 막으면 화면이 통째로 비어버림.
    match /submissions/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    // votes는 voteEpisode(Cloud Function)만 씀 — 클라 직접 write 전면 차단.
    match /votes/{docId} { allow read: if true; allow create, update, delete: if false; }
    // 초스피드 추천/신고 — speedrunUpvote/speedrunReport(Cloud Function) 전용,
    // 클라이언트가 직접 읽거나 쓸 이유 없음(보안방 전수조사 중 규칙 누락 발견,
    // 2026-08-03 — Admin SDK는 이 규칙과 무관하게 이미 정상 동작 중이었어서
    // 실제 노출은 없었지만, 명시적으로 잠가 규칙 목록을 코드와 일치시킴).
    match /submission_votes/{docId} { allow read, write: if false; }
    match /submission_reports/{docId} { allow read, write: if false; }
    match /comments/{docId} { allow read, write: if true; }
    match /bookmarks/{docId} { allow read, write: if true; }
    match /notifications/{docId} { allow read, write: if true; }
    match /story_likes/{docId} { allow read, write: if true; }
    // 🔒 2026-08-27 보안방 긴급수정: 클라이언트가 이 컬렉션에 직접 .set()으로
    // 문서를 만들 수 있어서(완전 공개 쓰기), fbVoteMvp의 검증(완결 여부/중복투표/
    // 본인글 여부 등)을 전부 건너뛰고 임의 nominated_user_id로 문서를 만든 뒤
    // grantMvpPoints를 호출하면 무제한 무료 포인트 발급이 가능했음(실제 재현
    // 확인함). 생성/수정/삭제는 이제 voteMvp Cloud Function(Admin SDK, 검증
    // 전부 서버에서 재확인 후 처리)만 가능 — 클라이언트는 읽기만 허용.
    match /story_mvp/{docId} { allow read: if true; allow create, update, delete: if false; }
    match /boosts/{docId} { allow read, write: if true; }
    match /extra_submits/{docId} { allow read, write: if true; }
    match /reports/{docId} { allow read, write: if true; }
    match /bug_reports/{docId} { allow read, write: if true; }
    match /patch_notes/{docId} { allow read, write: if true; }
    match /admin_edits/{docId} { allow read, write: if true; }
    match /visits/{docId} { allow read, write: if true; }
    match /diary_ending_reached/{docId} { allow read, write: if true; }
    match /account_deletion_reasons/{docId} { allow read, write: if true; }
    match /word_challenge_sets/{docId} { allow read, write: if true; }
    match /word_challenges/{docId} { allow read, write: if true; }
    match /word_challenge_submissions/{docId} { allow read, write: if true; }
    match /word_challenge_votes/{docId} { allow read, write: if true; }
    match /spotlight_word_pool/{docId} { allow read, write: if false; }
    match /spotlight_sentence_pool/{docId} { allow read, write: if false; }
    // 동화 각색 슬롯 씨앗 풀 — 관리자가 붙여넣는 텍스트가 곧바로 최종 큐가 되므로
    // (word_challenge_sets처럼 상위 게임 루프가 걸러주는 원재료가 아님) 저작권
    // 큐레이션 목적상 반드시 서버 전용(Admin SDK, adminAddFairytalePoolEntries 등)으로만
    // 써야 함 — 클라이언트 직접 write를 열어두면 큐레이션 취지가 무너짐.
    match /spotlight_fairytale_pool/{docId} { allow read, write: if false; }
    // 초성힌트: 씨앗 풀은 fairytale 풀과 동일 이유로 서버 전용. hint_rounds는
    // 반드시 완전히 잠가야 함 — Firestore 규칙은 문서 단위로만 열고 닫을 수
    // 있어서(필드 단위 비공개 불가), 조금이라도 클라이언트에서 읽히면
    // 정답(text)이 개발자 도구로 그대로 노출됨. 라운드 상태 조회는 반드시
    // getHintRound Cloud Function(진행 중엔 text를 응답에서 아예 뺌)으로만.
    // hint_guesses는 정답 텍스트가 안 들어있어 실시간 피드용으로 읽기만 열어둠.
    match /hint_pool/{docId} { allow read, write: if false; }
    match /hint_rounds/{docId} { allow read, write: if false; }
    match /hint_guesses/{docId} { allow read: if true; allow write: if false; }
    // 당신의 이야기(익명 한 줄 일지, 2026-08-18) — 문서에 user_id가 그대로
    // 들어있어서(익명 표시는 응답에서 벗겨내는 방식) hint_rounds와 동일한 이유로
    // 컬렉션 자체를 완전히 잠그고 submitYourStory/getYourStoryFeed 등 Cloud
    // Function(Admin SDK, user_id를 응답에서 제거)으로만 읽고 씀.
    match /your_story_posts/{docId} { allow read, write: if false; }
    match /your_story_hearts/{docId} { allow read, write: if false; }
    match /your_story_reports/{docId} { allow read, write: if false; }
    match /your_story_day_meta/{docId} { allow read, write: if false; }
    // 책 제목 신고 중복 방지용 — editStoryTitle/reportStoryTitle(Cloud
    // Function) 전용, your_story_reports와 동일 패턴.
    match /story_title_reports/{docId} { allow read, write: if false; }
    // 분석 대시보드 일별 집계 — computeAnalyticsDaily/backfillAnalyticsDaily(Admin
    // SDK)만 쓰고, getAnalyticsDashboard(_requireAdmin 게이트)를 통해서만 읽음.
    match /analytics_daily/{docId} { allow read, write: if false; }
    match /sentence_rounds/{docId} { allow read, write: if true; }
    match /sentence_round_submissions/{docId} { allow read, write: if true; }
    match /sentence_round_votes/{docId} { allow read, write: if true; }
    // 비밀번호 재설정 토큰 — 이메일 링크를 통해서만 소진돼야 하므로 클라이언트가
    // 직접 읽거나 쓸 이유가 전혀 없음(resetPasswordWithToken Cloud Function 전용).
    match /password_reset_tokens/{docId} { allow read, write: if false; }
    // 이메일 발송 rate limit 카운터 — findId/sendPasswordResetEmail Cloud Function
    // 전용(클라이언트가 직접 읽으면 남의 이메일 존재 여부/발송 이력이 새어나감).
    match /email_rate_limits/{docId} { allow read, write: if false; }
    // 로그인 실패 시도 카운터(brute-force 방어) — login Cloud Function 전용.
    // 클라이언트가 직접 쓰면 자기 실패 기록을 지워 쿨다운을 무력화할 수 있음.
    match /login_attempts/{docId} { allow read, write: if false; }
    match /story_visits/{docId} { allow read, write: if true; }
    // 스포트라이트 이야기 장르 확률 이력 — Cloud Function(_classifyStoryGenre,
    // Admin SDK)만 씀. 클라이언트는 카드/상세페이지 표시용으로 읽기만 함.
    match /story_genre_probs/{docId} { allow read: if true; allow write: if false; }
    // 공동집필 실시간 "쓰는 중" 표시용 — 8초 TTL(클라이언트가 최근 ping만
    // 신뢰) 방식이라 story_visits 등과 동일하게 민감정보 없음, 열어둠.
    match /episode_typing/{docId} { allow read, write: if true; }

    // ═══════════════════════════════════════════════════════════════════
    // English 에디션 (2026-08-30)
    //
    // 한국판과 **물리적으로 다른 컬렉션**을 쓴다. 처음엔 stories.edition 필드 +
    // 모든 쿼리에 조건을 붙이는 방식을 검토했는데, 조건이 필요한 지점이 19곳이었고
    // 한 곳만 빠뜨려도 즉시 한국 화면에 영어 콘텐츠가 섞이는 구조였다. 경로를
    // 나누면 collection('stories')를 읽는 기존 코드는 영어 데이터를 구조적으로
    // 볼 수 없다 — 빠뜨릴 필터 자체가 없다.
    //
    // 위 한국판 규칙은 한 줄도 바꾸지 않았다.
    //
    // 쓰기 정책: 영어 이야기 그래프는 **처음부터 전부 서버 전용**이다. 한국판은
    // 과거 클라이언트 직접 쓰기로 시작해 A-2에서 뒤늦게 잠갔지만(그 사이 위조
    // 사고가 있었다), 영어는 그 단계를 건너뛴다.
    // ═══════════════════════════════════════════════════════════════════

    // 이야기 그래프 — 읽기는 공개(목록·본문 렌더), 쓰기는 Cloud Function 전용.
    match /stories_en/{docId}     { allow read: if true; allow write: if false; }
    match /episodes_en/{docId}    { allow read: if true; allow write: if false; }
    match /submissions_en/{docId} { allow read: if true; allow write: if false; }
    match /votes_en/{docId}       { allow read: if true; allow write: if false; }

    // 이야기에 매달린 콘텐츠 — 집계·상태가 걸린 것은 서버 전용.
    match /story_likes_en/{docId}       { allow read: if true; allow write: if false; }
    match /story_mvp_en/{docId}         { allow read: if true; allow write: if false; }
    match /boosts_en/{docId}            { allow read: if true; allow write: if false; }
    match /extra_submits_en/{docId}     { allow read: if true; allow write: if false; }
    match /submission_votes_en/{docId}  { allow read: if true; allow write: if false; }
    match /story_visits_en/{docId}      { allow read: if true; allow write: if false; }
    match /story_genre_probs_en/{docId} { allow read: if true; allow write: if false; }

    // 신고·감사 로그 — 내용이 새면 안 되므로 읽기까지 차단(한국판 동일 성격).
    match /submission_reports_en/{docId}  { allow read, write: if false; }
    match /reports_en/{docId}             { allow read, write: if false; }
    match /admin_edits_en/{docId}         { allow read, write: if false; }
    match /story_title_reports_en/{docId} { allow read, write: if false; }

    // 경제·알림 — 에디션별 완전 분리(상호 사용 불가). 포인트를 users 문서가 아니라
    // 여기 두는 이유: users update는 클라이언트에 열려 있고 증가폭 가드가
    // total_points에만 걸려 있어서, users에 en_ 필드를 두면 그 가드를 안 타
    // 무제한 위조가 가능하다. 별도 컬렉션은 쓰기를 통째로 막을 수 있다.
    // 읽기까지 막는다 — 알림과 포인트 장부는 사용자별 활동 이력이라 전 세계
    // 공개 읽기로 두면 누가 무엇을 언제 했는지 그대로 드러난다(최종 검토 지적).
    // 현재 영어 앱은 이 컬렉션들을 직접 읽지 않는다. 나중에 프로필·알림 화면을
    // 열 때 필요한 필드만 반환하는 Callable로 노출한다.
    match /user_stats_en/{docId}    { allow read, write: if false; }
    match /point_ledger_en/{docId}  { allow read, write: if false; }
    match /notifications_en/{docId} { allow read, write: if false; }

    // 실시간 "쓰는 중" 표시 — 8초 TTL, 민감정보 없음(한국판 episode_typing과 동일).
    match /episode_typing_en/{docId} { allow read, write: if true; }

    // 댓글·북마크 — 한국판은 과거 경위로 열려 있지만, 영어판은 **처음부터 잠근다**.
    // 무인증 전체 쓰기로 열면 누구나 남의 댓글을 위조·수정·삭제하고 북마크를 들여다볼
    // 수 있다(최종 검토 지적). 현재 영어 앱은 이 경로를 쓰지도 않으므로 열어둘 이유가
    // 없다 — 나중에 댓글 기능을 열 때 서버 Callable로 만든다.
    match /comments_en/{docId}  { allow read: if true; allow write: if false; }
    match /bookmarks_en/{docId} { allow read, write: if false; }

    // Today 슬롯 포인터 — 클라이언트가 카드를 그리려면 읽어야 하지만, 쓰기를 열면
    // 누구나 카드가 가리키는 이야기를 바꿔치기할 수 있다. config/{configId}가
    // secrets 외 전부 쓰기 공개라 거기 두지 않고 별도 컬렉션으로 뺐다.
    match /en_spotlight/{docId} { allow read: if true; allow write: if false; }

    // 번역·승인·비용 — 미승인 번역문이 새면 안 되고 킬스위치를 누가 켜서도 안 되므로
    // 읽기까지 완전 차단. 관리자 Callable(Admin SDK)로만 접근한다.
    match /story_translations/{docId} { allow read, write: if false; }
    match /translation_control/{docId} { allow read, write: if false; }
    match /translation_usage/{docId}   { allow read, write: if false; }
    match /translation_logs/{docId}    { allow read, write: if false; }
  }
}
